{
  "schemaVersion": "workloom.agent-capabilities/v1",
  "bundleId": "consulting",
  "capabilities": [
    {
      "id": "consulting.repo.status",
      "version": "1.0.0",
      "title": "读取本仓自述",
      "description": "读取本仓 product.manifest 摘要与 bundles/docs/脚本计数；只读，不访问服务端。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/consulting/capabilities/repo.mjs",
        "export": "repoStatus"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.repo.docs",
      "version": "1.0.0",
      "title": "读取文档索引",
      "description": "列出 docs/*.md 与一级标题（最多 60 条），供 Agent 找 runbook 与规范；只读。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/consulting/capabilities/repo.mjs",
        "export": "repoDocs"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.bundle.summary",
      "version": "1.0.0",
      "title": "读取行业包概览",
      "description": "读取 bundles/consulting 的 skills/fences/pipelines/presets/library 计数与围栏规则样例；只读。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/consulting/capabilities/repo.mjs",
        "export": "bundleSummary"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.repo.readiness",
      "version": "1.0.0",
      "title": "检查接入就绪度（不执行）",
      "description": "检查 Node 版本、依赖、运行时资产、密钥文件、MCP 入口与内置 DSH 组件 pin；只读本地文件，不联网。",
      "operation": "preview",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/consulting/capabilities/repo.mjs",
        "export": "repoReadiness"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workforce.catalog",
      "version": "1.0.0",
      "title": "读取咨询员工与实装能力",
      "description": "读取当前咨询装配、22岗位与绑定技能、已实现/未接通工具边界和本轮模型预算；不得把资产数量等同于已验收能力。",
      "operation": "read",
      "risk": "low",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.catalog",
        "method": "query"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.task.dispatch",
      "version": "1.0.0",
      "title": "提交公开研究报告任务",
      "description": "沿用正式任务派遣入口；先保存UUID requestId，默认排队交正常调度器执行。只用于公开地区/行业研究，不接收客户私密档案或外发指令。提交回执不代表报告完成，运输中断后只读原requestId，不换号重购。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "idempotencyField": "requestId",
      "transport": {
        "kind": "trpc",
        "path": "threads.dispatch",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "goalRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
          "presetKey": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
          "runImmediately": { "type": "boolean", "default": false }
        },
        "required": ["requestId", "title"],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.task.dispatch_request",
      "version": "1.0.0",
      "title": "找回原公开研究提交",
      "description": "按原UUID只读提交认领和当前线程状态；不会重做意图分类、重新派遣或执行。dispatching或not-found不等于可换号重购；保留原标识与错误核验。",
      "operation": "receipt",
      "risk": "low",
      "dataMode": "real",
      "transport": { "kind": "trpc", "path": "threads.dispatchRequest", "method": "query" },
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          }
        },
        "required": ["requestId"],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.task.view",
      "version": "1.0.0",
      "title": "读取公开研究任务与来源回执",
      "description": "读取原咨询线程的六步进度、政府官网来源URL/日期/全文与摘录散列、真实最后事件与可用控制动作。draft_ready仍是内部待审稿，须另回读报告文件。",
      "operation": "receipt",
      "risk": "low",
      "dataMode": "real",
      "receiptField": "lastReceipt",
      "transport": { "kind": "trpc", "path": "consulting.taskView", "method": "query" },
      "inputSchema": {
        "type": "object",
        "properties": { "threadId": { "type": "string", "pattern": "^T-[A-Za-z0-9_-]{1,110}$" } },
        "required": ["threadId"],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.task.report",
      "version": "1.0.0",
      "title": "回读公开研究Markdown报告",
      "description": "服务端回读实际本机报告并核对sha256、UTF-8字节数和真实报告事件；保留原content/hash/receipt。文件未就绪或被修改即失败，不以任务状态代替交付。",
      "operation": "receipt",
      "risk": "low",
      "dataMode": "real",
      "receiptField": "receipt",
      "transport": { "kind": "trpc", "path": "consulting.taskReport", "method": "query" },
      "inputSchema": {
        "type": "object",
        "properties": { "threadId": { "type": "string", "pattern": "^T-[A-Za-z0-9_-]{1,110}$" } },
        "required": ["threadId"],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.task.action",
      "version": "1.0.0",
      "title": "继续、转人工或停止原公开研究任务",
      "description": "只控制原任务后续自动步骤，须使用稳定幂等键和服务端actionReceipt。继续复用原资料与流程；转人工暂停后续步骤；停止保留草稿/历史/费用，不代表撤销已发生动作。未知调用不可借继续重购。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "receiptField": "actionReceipt",
      "transport": { "kind": "trpc", "path": "consulting.taskAction", "method": "mutation", "timeoutMs": 120000 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "threadId": { "type": "string", "pattern": "^T-[A-Za-z0-9_-]{1,110}$" },
          "action": { "type": "string", "enum": ["resume", "handoff", "cancel"] },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 160 },
          "reason": { "type": "string", "maxLength": 500 }
        },
        "required": ["threadId", "action", "idempotencyKey"],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.dossier.put",
      "version": "1.0.0",
      "title": "建立企业授权资料档案",
      "description": "将客户已授权的文字资料经PII脱敏后记入本工作区一企一档；原文不独立背书，资料合计最多4000 UTF-8字节，重复幂等键不能改内容。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.dossierPut",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "enterpriseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_\\-\\u3400-\\u9fff]+$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,48}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "id",
                "title",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "enterpriseId",
          "sources",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.dossier.get",
      "version": "1.0.0",
      "title": "读取企业资料档案",
      "description": "只读取当前正式成员工作区的一企一档资料版本及事件回执，跨租户/工作区不可见。",
      "operation": "read",
      "risk": "low",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.dossierGet",
        "method": "query"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "enterpriseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_\\-\\u3400-\\u9fff]+$"
          }
        },
        "required": [
          "enterpriseId"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.submit",
      "version": "1.0.0",
      "title": "提交咨询材料分析任务",
      "description": "先建档再提交；指定employeeKey运行单员工；省略时真实模型拆成六步，服务端强制诊断证据→三专业员工→报告草稿→独立红队质检。只交内部草稿，不能代替人类定调或外发。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.submit",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "enterpriseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_\\-\\u3400-\\u9fff]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          },
          "employeeKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "skillId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "enterpriseId",
          "goal",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.advance",
      "version": "1.0.0",
      "title": "推进下一个受控步骤",
      "description": "只由服务端选择下一步；须有前序产物散列与事件回执。客户端不能指定跳步、代写完成或篡改员工/技能。每步最多一次真实模型调用，无自动重试。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.advance",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "runId",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.revalidate",
      "version": "1.0.0",
      "title": "重验已保存的原始模型响应",
      "description": "仅在产物校验失败且保留原始文件/散列/供应商回执时，从服务端原文件重验；不接受客户端产物，不调用模型，不重复计费。保留原失败与独立重验事件，继续检查原文引用、当前围栏和前序散列。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.revalidate",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "runId",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.pause",
      "version": "1.0.0",
      "title": "在步骤间暂停任务",
      "description": "仅已落盘步骤之间可暂停；进行中或结果未知的付费调用不会被重复执行。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.pause",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "runId",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.resume",
      "version": "1.0.0",
      "title": "恢复已暂停的任务",
      "description": "从服务端持久化的下一步骤恢复，保留原计划、档案版本、已完成产物与散列，不重新规划或重新计费。",
      "operation": "execute",
      "risk": "moderate",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.resume",
        "method": "mutation",
        "timeoutMs": 120000
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        },
        "required": [
          "runId",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.workflow.get",
      "version": "1.0.0",
      "title": "读取咨询流程与完整回执",
      "description": "读取计划、模型规划回执、每步员工/技能、前序依赖、产物散列和状态。draft_ready仅表示内部草稿已生成并待人类顾问审阅。",
      "operation": "receipt",
      "risk": "low",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.get",
        "method": "query"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "consulting.artifact.read",
      "version": "1.0.0",
      "title": "回读本地咨询草稿",
      "description": "回读已写盘Markdown并验证sha256/字节数/工作区路径与事件回执；缺失或被修改即失败，不能声称已交付。",
      "operation": "receipt",
      "risk": "low",
      "dataMode": "real",
      "transport": {
        "kind": "trpc",
        "path": "consulting.artifact",
        "method": "query"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^CR-[a-f0-9]{24}$"
          },
          "stepId": {
            "type": "string",
            "pattern": "^s[1-6]$"
          }
        },
        "required": [
          "runId",
          "stepId"
        ],
        "additionalProperties": false
      }
    }
  ]
}
