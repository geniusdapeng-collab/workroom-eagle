# ============ 数据库（docker-compose 默认口径） ============
DATABASE_URL=postgres://postgres:workloom@localhost:5432/workloom
# 应用双角色（A3：旁路直写防控——只有 gateway 角色可 INSERT biz_events）
APP_DB_PASSWORD=workloom_dev_app
GATEWAY_DB_PASSWORD=workloom_dev_gateway
DATABASE_APP_URL=postgres://workloom_app:workloom_dev_app@localhost:5432/workloom
DATABASE_GATEWAY_URL=postgres://workloom_gateway:workloom_dev_gateway@localhost:5432/workloom

# ============ 正式模型（密钥由本机受保护配置注入；未配置时明确报错） ============
# mock | deepseek | moonshot | zhipu | openai
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ============ IM 通道（正式未配置时禁用，不模拟发送） ============
# disabled；真实 IM 通道接通并验证后由受控连接器启用。mock 只用于隔离开发测试。
IM_DRIVER=disabled

# ============ 演示身份 JWT（B5） ============
# 生产（NODE_ENV=production）必配：缺失直接拒启；<32 字符启动告警（熵不足）
# 生成建议：openssl rand -hex 32
JWT_SECRET=workloom-dev-secret-change-me

# ============ PII 脱敏盐（M2-PII；生产必配） ============
# 占位符 HMAC-SHA256 盐（workdata/pii.ts，防彩虹表反推明文）；生产必须注入，变更后新旧占位符不可关联
PII_SALT=workloom-dev-pii-salt

# ============ 服务端口 ============
SERVER_PORT=8787
WEB_PORT=5173

# ============ 桌面端首启种子脚本（按仓配置；不在 base-sync 同步范围，各仓自定） ============
DESKTOP_SEED_SCRIPT=scripts/seed-production.ts

# 游客与种子成员直登仅可在隔离开发测试中显式开启，生产永远关闭。
WORKLOOM_ALLOW_DEMO_AUTH=0
